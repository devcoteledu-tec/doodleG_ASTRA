# ─────────────────────────────────────────────────────────────────────────────
# doodle_G — environment variables
#
# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Validation lives in src/lib/env.ts and runs once at server boot via the
# `register()` hook in instrumentation.ts — NOT at `next build` time, so a
# build never fails just because CI lacks runtime secrets.
#
#   REQUIRED (all environments)  missing anywhere  => server refuses to boot
#   REQUIRED (production only)   missing in dev    => mock fallback + warning
#                                missing in prod   => server refuses to boot
#   OPTIONAL                     missing anywhere  => feature is skipped
#
# On Vercel, set the same keys under Project → Settings → Environment
# Variables (Production + Preview). See DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# Supabase — REQUIRED in ALL environments
# ═════════════════════════════════════════════════════════════════════════════
# Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — server-only, bypasses Row-Level Security. NEVER prefix
# this with NEXT_PUBLIC_ and never import it from client-side code. Every
# database call in this app goes through src/lib/supabaseAdmin.ts, which is
# only ever reached from route handlers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OPTIONAL. No code path reads the anon key today (all access is service-role
# via route handlers), so env.ts no longer requires it. Harmless to keep set
# if you use the Supabase JS client directly in a scratch script.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here


# ═════════════════════════════════════════════════════════════════════════════
# Sessions — REQUIRED in ALL environments
# ═════════════════════════════════════════════════════════════════════════════
# Signs session JWTs and the short-lived auth-flow tokens used by the email
# OTP step. Must be at least 32 characters. Generate with:
#   openssl rand -base64 48
# Rotating this value invalidates every active session.
SESSION_SECRET=replace-with-a-long-random-value-at-least-32-characters


# ═════════════════════════════════════════════════════════════════════════════
# Cron — REQUIRED in PRODUCTION only
# ═════════════════════════════════════════════════════════════════════════════
# Bearer token guarding GET /api/cron, which triggers billed Gemini + Twilio
# calls. An unguarded endpoint here is a direct route to running up a bill.
# Generate with: openssl rand -hex 32   (minimum 16 characters)
# On Vercel, Cron Jobs send this automatically as
# `Authorization: Bearer <CRON_SECRET>` — see vercel.json.
CRON_SECRET=replace-with-a-long-random-value


# ═════════════════════════════════════════════════════════════════════════════
# Google Gemini — OPTIONAL (catalog ranking works without AI)
# ═════════════════════════════════════════════════════════════════════════════
# Adds AI ranking and card writing. Catalog recommendations fall back to real
# products when unset. Card writing requires this key in production.
GEMINI_API_KEY=


# ═════════════════════════════════════════════════════════════════════════════
# Twilio (WhatsApp) — REQUIRED in PRODUCTION only
# ═════════════════════════════════════════════════════════════════════════════
# Missing in development: src/services/whatsapp.ts logs the message instead of
# sending it, with a console warning. TWILIO_SENDER_NUMBER must keep the
# `whatsapp:` prefix; the value below is Twilio's shared sandbox number.
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_SENDER_NUMBER=whatsapp:+14155238886


# ═════════════════════════════════════════════════════════════════════════════
# Resend (transactional email) — REQUIRED in PRODUCTION only
# ═════════════════════════════════════════════════════════════════════════════
# Sends the 6-digit signup verification codes (src/services/email.ts, called
# from /api/auth/signup and /api/auth/resend-code). Missing in development:
# the send is simulated and the code is printed to the server console, so you
# can complete signup locally without a key. Missing in production: the route
# throws rather than pretending the email went out.
RESEND_API_KEY=your-resend-api-key-here

# From address. Must be on a domain verified in Resend, or delivery fails.
# Defaults to `doodle_G <onboarding@doodleg.app>` when unset.
RESEND_FROM_EMAIL=doodle_G <noreply@doodleg.in>

# OPTIONAL. Where replies to verification emails land. Omitted from the
# message entirely when unset.
# RESEND_REPLY_TO=support@doodleg.in


# ═════════════════════════════════════════════════════════════════════════════
# Google Sign-In — OPTIONAL
# ═════════════════════════════════════════════════════════════════════════════
# OAuth 2.0 Web application client ID (Google Cloud Console → APIs & Services
# → Credentials). Read by the auth page and by /api/auth/google to verify the
# returned ID token's audience. When unset, the Google button is hidden and
# email + OTP signup still works.
# Authorised JavaScript origins must include your production domain
# (https://www.doodleg.in) and http://localhost:3000 for local dev.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com


# ═════════════════════════════════════════════════════════════════════════════
# PostHog (analytics) — OPTIONAL
# ═════════════════════════════════════════════════════════════════════════════
# Powers visitor counts, page views, time-on-page/session duration
# (automatic once set), and sign-in/sign-up event tracking (explicit
# captureServerEvent calls in src/lib/posthogServer.ts, called from the
# signin/signup/google/verify-email/complete-profile API routes).
# Free tier at https://posthog.com — Project Settings → Project API Key.
# When unset, src/components/PostHogProvider.tsx and src/lib/posthogServer.ts
# both no-op — the site works identically, just without analytics.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-api-key-here
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# ═════════════════════════════════════════════════════════════════════════════
# SEO — OPTIONAL, strongly recommended in PRODUCTION
# ═════════════════════════════════════════════════════════════════════════════
# Canonical production domain, no trailing slash. Feeds metadataBase,
# canonical URLs, Open Graph/Twitter card URLs, JSON-LD, robots.txt and
# sitemap.xml — see src/lib/seo.ts. Falls back to https://www.doodleg.in so
# builds never fail without it, but every canonical/OG URL will point at the
# wrong host until this matches the deployed domain.
NEXT_PUBLIC_SITE_URL=https://www.doodleg.in


# ═════════════════════════════════════════════════════════════════════════════
# Search engine verification — OPTIONAL
# ═════════════════════════════════════════════════════════════════════════════
# The Google Search Console token for www.doodleg.in is checked into
# src/lib/seo.ts on purpose: it's public by design (it ships in the page
# HTML), and an unset env var silently drops the meta tag, which un-verifies
# the property. Only set this if Google issues a different token.
# GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools content value (rendered as msvalidate.01). No Bing
# property registered yet — leave unset and the meta tag is simply omitted.
# BING_SITE_VERIFICATION=


# ═════════════════════════════════════════════════════════════════════════════
# Razorpay — required in PRODUCTION only (Test Mode keys work fine in dev)
# ═════════════════════════════════════════════════════════════════════════════
# Powers the "Pay Online" checkout option (src/lib/razorpay.ts,
# /api/checkout/razorpay-order, /api/orders' payment verification). Replaces
# the old hardcoded UPI deep-link flow — see supabase_migration_030 and
# src/app/cart/CartPageClient.tsx's history for why that had to go.
#
# Get these from the Razorpay Dashboard → Account & Settings → API Keys
# (under "Website and app settings") → Generate Key. Generate a SEPARATE
# pair for Test Mode and Live Mode — never reuse one across the two.
#
# NEXT_PUBLIC_RAZORPAY_KEY_ID: safe to expose to the browser (that's what
# NEXT_PUBLIC_ means) — Razorpay Checkout.js needs it client-side to open
# the payment modal. It identifies your account, not a secret by itself.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# RAZORPAY_KEY_SECRET: server-only. Used to create orders via the Razorpay
# API and to verify the HMAC-SHA256 payment signature Razorpay sends back
# after checkout — this is what proves a payment actually happened and
# wasn't forged by the client. NEVER prefix this with NEXT_PUBLIC_ and never
# import it from client-side code.
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here

# Upgrade: required payment recovery and approved WhatsApp templates.
RAZORPAY_WEBHOOK_SECRET=
TWILIO_CONTENT_SID=
# Exact externally visible Twilio webhook URL (including any query string).
TWILIO_WEBHOOK_URL=https://your-domain.example/api/whatsapp/webhook
# Flat merchant shipping charge per provider parcel, NOT a carrier quote.
SHIPPING_FLAT_RATE_RUPEES=40

# Required in production: real inbox receiving contact-form requests.
SUPPORT_EMAIL=
